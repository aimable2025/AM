    isSystemAdmin()

    ||

    (
      isDG()
      &&
      hasPermission('commissions.manage')
      &&
      dgFeatureEnabled('commissions.manage')
    )

    ||

    (
      isAdministrateurAgence()
      &&
      hasPermission('commissions.manage')
      &&
      belongsToAgency(
        resource.data.get('agencyId', null)
      )
      &&
      globalFeatureEnabled('commissions.manage')
    )

    ||

    (
      hasPermission('commissions.manage')
      &&
      belongsToAgency(
        resource.data.get('agencyId', null)
      )
      &&
      globalFeatureEnabled('commissions.manage')
    );


  allow create: if

    isSystemAdmin()

    ||

    (
      isDG()
      &&
      hasPermission('commissions.manage')
      &&
      dgFeatureEnabled('commissions.manage')
      &&
      request.resource.data.get('agencyId', null) != null
    )

    ||

    (
      isAdministrateurAgence()
      &&
      hasPermission('commissions.manage')
      &&
      globalFeatureEnabled('commissions.manage')
      &&
      request.resource.data.get('agencyId', null)
         == currentAgencyId()
    )

    ||

    (
      hasPermission('commissions.manage')
      &&
      globalFeatureEnabled('commissions.manage')
      &&
      request.resource.data.get('agencyId', null)
         == currentAgencyId()
    );


  allow update: if

    isSystemAdmin()

    ||

    (
      isDG()
      &&
      hasPermission('commissions.manage')
      &&
      dgFeatureEnabled('commissions.manage')
      &&
      request.resource.data.get('agencyId', null)
         == resource.data.get('agencyId', null)
    )

    ||

    (
      isAdministrateurAgence()
      &&
      hasPermission('commissions.manage')
      &&
      globalFeatureEnabled('commissions.manage')
      &&
      resource.data.get('agencyId', null)
         == currentAgencyId()
      &&
      request.resource.data.get('agencyId', null)
         == currentAgencyId()
    )

    ||

    (
      hasPermission('commissions.manage')
      &&
      globalFeatureEnabled('commissions.manage')
      &&
      resource.data.get('agencyId', null)
         == currentAgencyId()
      &&
      request.resource.data.get('agencyId', null)
         == currentAgencyId()
    );


  allow delete: if isSystemAdmin();
}


/* =========================================================
   JOURNAL D'AUDIT
   ========================================================= */

match /auditLogs/{logId} {

  allow read: if
    isSystemAdmin()
    ||
    hasPermission('audit.read');

  allow create: if isActiveUser();

  allow update, delete: if false;
}

/* =========================================================
   OPERATIONS & AFFECTATIONS D'OPERATIONS (SyncWorker)
   ========================================================= */

match /operations/{operationId} {
  allow read: if isActiveUser();

  allow create, update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    isAdministrateurAgence()
    ||
    isAgent();

  allow delete: if isSystemAdmin() || isDG();
}

match /operationAssignments/{assignmentId} {
  allow read: if isActiveUser();

  allow create, update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    isAdministrateurAgence()
    ||
    isAgent();

  allow delete: if isSystemAdmin() || isDG();
}

match /debts/{debtId} {
  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      (isAdministrateurAgence() || isAgent())
      &&
      belongsToAgency(resource.data.get('agencyId', null))
    );

  allow create, update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      (isAdministrateurAgence() || isAgent())
      &&
      request.resource.data.get('agencyId', null) == currentAgencyId()
    );

  allow delete: if isSystemAdmin() || isDG();
}

match /interAgencyTransfers/{transferId} {
  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      (isAdministrateurAgence() || isAgent())
      &&
      (
        resource.data.get('sourceAgencyId', null) == currentAgencyId()
        ||
        resource.data.get('targetAgencyId', null) == currentAgencyId()
      )
    );

  allow create, update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    isAdministrateurAgence()
    ||
    isAgent();

  allow delete: if isSystemAdmin() || isDG();
}


/* =========================================================
   MESSAGES
   ========================================================= */

match /messages/{messageId} {

  allow read, create: if isActiveUser() || isSignedIn();

  allow update: if isActiveUser() || isSignedIn();

  allow delete: if
    isSystemAdmin()
    ||
    isDG()
    ||
    ((isActiveUser() || isSignedIn()) && resource.data.senderId == request.auth.uid);
}


/* =========================================================
   NUMEROS INTERNES
   ========================================================= */

match /internalNumbers/{numberId} {

  allow read: if isActiveUser();

  allow create, update, delete: if
    isSystemAdmin()
    ||
    (
      hasPermission('internal_numbers.manage')
      &&
      (
        isDG()
        ? dgFeatureEnabled('internal_numbers.manage')
        : globalFeatureEnabled('internal_numbers.manage')
      )
    );
}


/* =========================================================
   OPERATIONS SMS DES NUMEROS INTERNES

   Flux :
   Téléphone de l'agent
        ↓
   SMS opérateur
        ↓
   Dexie / Offline Queue
        ↓
   Firestore smsOperations
        ↓
   DG / supervision

   SECURITE :
   - Administrateur Système : accès global
   - DG : lecture globale
   - Administrateur d'agence : lecture de son agence
   - Agent : écrit uniquement pour son numéro affecté
   - Client / Abonné : aucun accès
   ========================================================= */

match /smsOperations/{operationId} {

  /* -------------------------------------------------------
     LECTURE
     ------------------------------------------------------- */

  allow read: if

    isSystemAdmin()

    ||

    (
      isDG()
      &&
      hasPermission('transactions.manage')
      &&
      dgFeatureEnabled('transactions.manage')
    )

    ||

    (
      isAdministrateurAgence()
      &&
      hasPermission('transactions.manage')
      &&
      resource.data.get('agencyId', null)
         == currentAgencyId()
      &&
      globalFeatureEnabled('transactions.manage')
    );


  /* -------------------------------------------------------
     CREATION PAR LE TELEPHONE DE L'AGENT
     
     L'agent ne peut envoyer un SMS que pour :
     - un numéro interne existant
     - qui lui est affecté
     - appartenant à sa propre agence
     - avec le monitoring activé
     ------------------------------------------------------- */

  allow create: if

    isSystemAdmin()

    ||

    (
      isAgent()
      &&
      request.resource.data.get('agencyId', null)
         == currentAgencyId()

      &&

      request.resource.data.get('internalNumberId', null)
         != null

      &&

      exists(
        /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
      )

      &&

      get(
        /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
      ).data.get('assignedUserId', null)
         == request.auth.uid

      &&

      get(
        /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
      ).data.get('agencyId', null)
         == currentAgencyId()

      &&

      get(
        /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
      ).data.get('monitoringEnabled', false)
         == true

      &&

      request.resource.data.get('operator', null)
         ==
      get(
        /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
      ).data.get('operator', null)
    );


  /* -------------------------------------------------------
     MISE A JOUR
     
     L'agent peut mettre à jour uniquement une opération
     provenant de son propre numéro interne.
     
     Cela permet notamment au worker de mettre à jour :
     - syncStatus
     - status
     - processedAt
     - updatedAt
     ------------------------------------------------------- */

  allow update: if

    isSystemAdmin()

    ||

    (
      isAgent()

      &&

      resource.data.get('agencyId', null)
         == currentAgencyId()

      &&

      resource.data.get('internalNumberId', null)
         != null

      &&

      exists(
        /databases/$(database)/documents/internalNumbers/$(resource.data.internalNumberId)
      )

      &&

      get(
        /databases/$(database)/documents/internalNumbers/$(resource.data.internalNumberId)
      ).data.get('assignedUserId', null)
         == request.auth.uid

      &&

      request.resource.data.get('internalNumberId', null)
         == resource.data.get('internalNumberId', null)

      &&

      request.resource.data.get('agencyId', null)
         == resource.data.get('agencyId', null)

      &&

      request.resource.data.get('operator', null)
         == resource.data.get('operator', null)
    );


  /* -------------------------------------------------------
     SUPPRESSION
     ------------------------------------------------------- */

  allow delete: if isSystemAdmin();
}


/* =========================================================
   NOTIFICATIONS
   ========================================================= */

match /notifications/{notificationId} {

  allow read: if isActiveUser();

  allow create: if isActiveUser();

  allow update: if isActiveUser();

  allow delete: if isSystemAdmin() || isDG();
}


/* =========================================================
   SALAIRES MENSUELS DES AGENTS (salaries)
   ========================================================= */

match /salaries/{salaryId} {

  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      (
        resource.data.get('agentId', null) == request.auth.uid
        ||
        resource.data.get('designatedPayerId', null) == request.auth.uid
        ||
        (
          resource.data.get('agencyId', null) == currentAgencyId()
          &&
          (isAdministrateurAgence() || isAgent())
        )
      )
    );

  /* Seul le DG (ou Admin Système) peut créer/configurer un salaire */
  allow create: if isSystemAdmin() || isDG();

  /* Mise à jour contrôlée :
     - DG / Admin Système : autorisation complète
     - Agent concerné : uniquement confirmation de réception (sans modifier plannedAmount ni agentId)
     - Payeur désigné : uniquement exécution du paiement autorisé (sans modifier plannedAmount ni agentId)
  */
  allow update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      resource.data.get('agentId', null) == request.auth.uid
      &&
      request.resource.data.get('agentId', null) == resource.data.get('agentId', null)
      &&
      request.resource.data.get('plannedAmount', 0) == resource.data.get('plannedAmount', 0)
    )
    ||
    (
      isActiveUser()
      &&
      (
        resource.data.get('designatedPayerId', null) == request.auth.uid
        ||
        resource.data.get('agencyId', null) == currentAgencyId()
      )
      &&
      request.resource.data.get('agentId', null) == resource.data.get('agentId', null)
      &&
      request.resource.data.get('plannedAmount', 0) == resource.data.get('plannedAmount', 0)
    );

  allow delete: if isSystemAdmin();
}


/* =========================================================
   RECLAMATIONS DE SALAIRE EN RETARD (salaryClaims)
   ========================================================= */

match /salaryClaims/{claimId} {

  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      resource.data.get('agentId', null) == request.auth.uid
    );

  allow create: if
    isActiveUser()
    &&
    request.resource.data.get('agentId', null) == request.auth.uid;

  allow update: if isSystemAdmin() || isDG();

  allow delete: if isSystemAdmin();
}


/* =========================================================
   AVANCES SUR SALAIRE (salaryAdvances)
   ========================================================= */

match /salaryAdvances/{advanceId} {

  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      (
        resource.data.get('agentId', null) == request.auth.uid
        ||
        resource.data.get('designatedPayerId', null) == request.auth.uid
        ||
        resource.data.get('agencyId', null) == currentAgencyId()
      )
    );

  /* Un agent actif soumet sa propre demande d'avance avec décision initialisée à en_attente */
  allow create: if
    isActiveUser()
    &&
    request.resource.data.get('agentId', null) == request.auth.uid
    &&
    request.resource.data.get('dgDecision', 'en_attente') == 'en_attente';

  /* Seul le DG peut modifier dgDecision / approvedMonthsCount. Le payeur ou l'agent ne peut pas modifier dgDecision */
  allow update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      (
        resource.data.get('agentId', null) == request.auth.uid
        ||
        resource.data.get('designatedPayerId', null) == request.auth.uid
        ||
        resource.data.get('agencyId', null) == currentAgencyId()
      )
      &&
      request.resource.data.get('dgDecision', null) == resource.data.get('dgDecision', null)
      &&
      request.resource.data.get('approvedMonthsCount', null) == resource.data.get('approvedMonthsCount', null)
    );

  allow delete: if isSystemAdmin();
}


/* =========================================================
   DETTES & TRANSFERTS INTER-AGENCES
   ========================================================= */

match /debts/{debtId} {
  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (isActiveUser() && resource.data.get('agencyId', null) == currentAgencyId());

  allow create, update: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (isActiveUser() && request.resource.data.get('agencyId', null) == currentAgencyId());

  allow delete: if isSystemAdmin() || isDG();
}

match /interAgencyTransfers/{transferId} {
  allow read: if
    isSystemAdmin()
    ||
    isDG()
    ||
    (
      isActiveUser()
      &&
      (
        resource.data.get('sourceAgencyId', null) == currentAgencyId()
        ||
        resource.data.get('targetAgencyId', null) == currentAgencyId()
      )
    );

  allow create, update: if isActiveUser();

  allow delete: if isSystemAdmin() || isDG();
}


/* =========================================================
   REGLEMENTS
   ========================================================= */

match /regulations/{regulationId} {

  allow read: if isActiveUser();

  allow create, update, delete: if isSystemAdmin();
}


/* =========================================================
   ACCEPTATION DES REGLEMENTS
   ========================================================= */

match /regulationAcceptances/{acceptanceId} {

  allow read: if
    (
      isSignedIn()
      &&
      resource.data.userId == request.auth.uid
    )
    ||
    isSystemAdmin();

  allow create: if
    isActiveUser()
    &&
    request.resource.data.userId == request.auth.uid;

  allow update, delete: if isSystemAdmin();
}


/* =========================================================
   DENI PAR DEFAUT
   ========================================================= */

match /{document=**} {
  allow read, write: if false;
}

}
}
